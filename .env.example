# Copy to .env and fill in. Never commit .env.

# --- Core -----------------------------------------------------------------
ENVIRONMENT=production                 # development | test | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database -------------------------------------------------------------
# Docker Compose builds DATABASE_URL from POSTGRES_PASSWORD automatically.
POSTGRES_PASSWORD=change-me
# For running the backend outside Docker (SQLite is only a development fallback):
DATABASE_URL=postgresql+psycopg://sentinelx:change-me@localhost:5432/sentinelx

# --- Web ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false                   # set true behind HTTPS
FRONTEND_PORT=8080
ALLOW_REGISTRATION=true

# --- AI (optional; without it the assistant runs in DEMO AI / LOCAL ANALYSIS mode) --
LLM_PROVIDER=none                     # none | anthropic | openai
LLM_API_KEY=
LLM_MODEL=                            # default: claude-opus-5 (anthropic) / gpt-4o-mini (openai)
LLM_BASE_URL=                         # optional, OpenAI-compatible endpoints only
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_ROUNDS=4
LLM_REFUSAL_FALLBACK=true             # Anthropic server-side refusal fallback for claude-opus-5 / claude-fable-5-1

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_UPLOAD_ROWS=200000
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# --- Demo seed (optional) -------------------------------------------------
SEED_DEMO=false                       # true: create shared Nova Bank demo workspace + demo accounts on start
SEED_DEMO_PASSWORD=                   # password for admin@/analyst@/viewer@novabank.demo (10+ chars, letter + digit)
